{
  "name": "vidyut-panchayat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "batch": "tsx scripts/batch.ts",
    "replay:forecast": "node --import tsx scripts/forecast-replay.ts",
    "policy:select": "node --import tsx scripts/policy-experiment.ts select",
    "policy:validate": "node --import tsx scripts/policy-experiment.ts validate",
    "policy:confirm": "node --import tsx scripts/policy-experiment.ts confirm",
    "policy:audit:freeze": "node --import tsx scripts/freeze-policy-audit.ts",
    "policy:audit:episodes": "ml/.venv/bin/python ml/build_fresh_audit.py",
    "policy:audit": "node --import tsx scripts/policy-experiment.ts audit",
    "policy:revision:freeze": "node --import tsx scripts/freeze-policy-revision.ts",
    "policy:revision:episodes": "ml/.venv/bin/python ml/build_fresh_audit.py --revision",
    "policy:revision:audit": "node --import tsx scripts/policy-experiment.ts revision",
    "evidence:ml": "node --import tsx scripts/export-ml-evidence.ts",
    "ml:infer": "ml/.venv/bin/python ml/infer_electricity.py",
    "demo:ml": "node --import tsx scripts/record-ml-demo.ts",
    "demo": "npm run build && tsx scripts/package-offline.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:historical-browser": "node --import tsx scripts/forecast-browser-smoke.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "benchmark": "tsx scripts/performance.ts",
    "test:council": "node --import tsx scripts/council-room-smoke.ts"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "lil-gui": "^0.21.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
